# Copier ce fichier en « .env » et le remplir. Ne jamais le publier ni le sauvegarder dans Git.

# Adresse de votre site (origine uniquement, sans chemin). Plusieurs : séparées par des virgules.
ALLOWED_ORIGIN=https://elysee-2027.github.io

# Jeton d'administration : 32 caractères aléatoires minimum (ex. « openssl rand -hex 24 »).
ADMIN_TOKEN=

# Jeton du tunnel Cloudflare (Zero Trust > Réseaux > Tunnels > votre tunnel > Docker).
TUNNEL_TOKEN=

# Identifiants de l'utilisateur qui possède le dossier ./data sur le NAS (commande « id » en SSH).
PUID=1026
PGID=100

# Conservation des messages du formulaire, en jours.
RETENTION_DAYS=365

# Facultatif : notification (titre seulement, jamais le contenu) vers un service ntfy.
# NTFY_URL=https://ntfy.sh/un-nom-de-canal-long-et-aleatoire
